# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Zavu (email + SMS + WhatsApp) ─────────────────────────────────────────────
ZAVU_API_KEY=zv_live_xxxxxxxxxxxxxxxxxxxxxxxx
ZAVU_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Proveedor de email ────────────────────────────────────────────────────────
# zavu (por defecto) | resend — SMS y WhatsApp siempre salen por Zavu.
# Es el valor inicial: lo que se guarde en Configuración (plataforma) tiene prioridad
EMAIL_PROVIDER=zavu
# Requeridos para poder usar Resend (por variable o desde la plataforma)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Finto <notificaciones@tudominio.com>
# Copias ocultas en todos los correos, separadas por coma (solo con Resend)
# EMAIL_BCC=copias@tudominio.com

# ── App ───────────────────────────────────────────────────────────────────────
RS_TEAM_EMAIL=equipo@tufirma.com
PLATFORM_URL=https://app.tudominio.com
PORT=3000
NODE_ENV=development

# ── CORS (orígenes permitidos separados por coma) ────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ── Redis (Railway lo inyecta automáticamente en producción) ──────────────────
REDIS_URL=redis://localhost:6379

# ── Siigo (opcional) ─────────────────────────────────────────────────────────
# Credenciales de la cuenta Siigo de Finto (conexión de plataforma). Las de cada
# empresa cliente se guardan cifradas desde Empresas → Siigo.
# SIIGO_USERNAME=
# SIIGO_ACCESS_KEY=
# SIIGO_PARTNER_ID=RSHUBS
# Clave para cifrar credenciales en la base (openssl rand -base64 32)
# SECRETS_ENCRYPTION_KEY=
